# tydex environment variables
# Copy to .env and fill in. Variables here are the ones the CLI and HTTP
# server read from the environment. A `KEY=value` line is the standard form.

# --- HTTP server auth (optional) ---------------------------------------------
# python -m tydex.server --api-key ...  or  set TYDEX_API_KEY:
# TYDEX_API_KEY=change-me

# --- OpenAI cloud ------------------------------------------------------------
# API key. Used by: --provider openai, --provider openai_compatible_cloud
# OPENAI_API_KEY=sk-...
# Optional override of the endpoint for openai_compatible_cloud:
# OPENAI_BASE_URL=https://api.openai.com/v1
# Optional default model (provider default is gpt-4o-mini):
# OPENAI_MODEL=gpt-4o-mini

# --- Ollama ------------------------------------------------------------------
# Cloud key (e.g. https://ollama.com/v1) or local server key.
# Used by: --provider openai_compatible_cloud / openai_compatible_local
# OLLAMA_API_KEY=...
# Local OpenAI-compatible server endpoint for --provider openai_compatible_local
# (default http://localhost:8000/v1). Also used by the native ollama provider.
# OLLAMA_HOST=http://localhost:11434
# Default model for the native ollama provider (default llama3.1:8b):
# OLLAMA_MODEL=llama3.1:8b

# --- Anthropic ---------------------------------------------------------------
# API key. Used by: --provider anthropic (required).
# ANTHROPIC_API_KEY=sk-ant-...
# Optional default model (provider default is claude-3-5-haiku-latest):
# ANTHROPIC_MODEL=claude-3-5-haiku-latest